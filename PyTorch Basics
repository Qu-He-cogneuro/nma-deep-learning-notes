# Reproducibility: Because many “random” steps in machine learning affect the final result. For example, randomness can appear in:
# random initialization: model weights start with random values
# random data split: train/test split chooses random examples
# random mini-batches: DataLoader shuffles data
# dropout: some neurons are randomly turned off during training

# PyTorch Random Number Generator (RNG): You can use torch.manual_seed() to seed the RNG for all devices (both CPU and GPU):

import torch
torch.manual_seed(0) #The number 0 is not special. You could also use others. Each seed gives a different repeatable random sequence.

# for custom operators, set python seed as well
import random
random.seed(0)

# Random number generators in other libraries (e.g., NumPy):
import numpy as np
np.random.seed(0)

# seeding helper function that does all three above
def set_seed(seed=None, seed_torch=True):
  """
  Function that controls randomness. NumPy and random modules must be imported.

  Args:
    seed : Integer
      A non-negative integer that defines the random state. Default is `None`. 
      # when calling the function, you do not have to provide a seed, the function randomly chooses one for you.
    seed_torch : Boolean
      If `True` sets the random seed for pytorch tensors, so pytorch module
      must be imported. Default is `True`. #by default, the function will also set PyTorch’s random seed.

  Returns:
    Nothing.
  """
  if seed is None:
    seed = np.random.choice(2 ** 32) # So this line chooses a random integer between 0 and 2**32 - 1.
                                     # This is useful because the function will tell you which seed it picked at the end 
  random.seed(seed)
  np.random.seed(seed)
  if seed_torch:
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.cuda.manual_seed(seed)
    torch.backends.cudnn.benchmark = False
    torch.backends.cudnn.deterministic = True

  print(f'Random seed {seed} has been set.') # So later, you can reuse that exact seed if you want to reproduce the result.
# verification of the seeding helper function
def simplefun(seed=True, my_seed=None):
  """
  Helper function to verify effectiveness of set_seed attribute
  #if seed=False, set_seed function is not called, randomness not controlled
  #if seed=True, my_seed = None, set_seed function is called, randomness not controlled, but we know the seed to reproduce
  #if seed=True, my_seed = 0, set_seed function is called, randomness  controlled
  Args:
    seed: Boolean
      Specifies if seed value is provided or not
    my_seed: Integer
      Initializes seed to specified value

  Returns:
    Nothing
  """
  if seed:
    set_seed(seed=my_seed)

  # uniform distribution
