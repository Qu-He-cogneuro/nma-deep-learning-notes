# We can construct a tensor directly from some common python iterables,
# such as list and tuple nested iterables can also be handled as long as the
# dimensions are compatible

# tensor from a list
a = torch.tensor([0, 1, 2])

#tensor from a tuple of tuples
b = ((1.0, 1.1), (1.2, 1.3))
b = torch.tensor(b)

# tensor from a numpy array
c = np.ones([2, 3])
c = torch.tensor(c)
# Tensor c: tensor([[1., 1., 1.],
#        [1., 1., 1.]], dtype=torch.float64)
# Note:
# pytorch default: float32 = 32 bits = 4 bytes per number
# np.array default: float64 = 64 bits = 8 bytes per number
# if 1mil numbers: float32: about 4 MB; float64: about 8 MB
# On GPUs, float32 is usually much faster than float64.
# Neural networks usually do not need extremely high decimal precision, but they do need speed.

print(f"Tensor a: {a}")
print(f"Tensor b: {b}")
print(f"Tensor c: {c}")
